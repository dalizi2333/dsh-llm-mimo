{
  "name": "@local/llm-mimo",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "description": "MiMo-native LLM adapter (Anthropic Messages dialect) for MiMo CodeX",
  "dependencies": {
    "@deepseek-ai/dsh-llm": "link:../../../../../../../runtimes/0.1.7-rc.2/node_modules/@deepseek-ai/dsh-llm",
    "@deepseek-ai/dsh-credentials": "link:../../../../../../../runtimes/0.1.7-rc.2/node_modules/@deepseek-ai/dsh-credentials",
    "@deepseek-ai/schemastery": "link:../../../../../../../runtimes/0.1.7-rc.2/node_modules/@deepseek-ai/schemastery",
    "@deepseek-ai/cosmokit": "link:../../../../../../../runtimes/0.1.7-rc.2/node_modules/@deepseek-ai/cosmokit",
    "eventsource-parser": "link:../../../../../../../runtimes/0.1.7-rc.2/node_modules/eventsource-parser",
    "@deepseek-ai/dsh-launch-environment": "link:../../../../../../../runtimes/0.1.7-rc.2/node_modules/@deepseek-ai/dsh-launch-environment"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  }
}